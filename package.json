{
  "name": "mcp-whatsapp-web",
  "version": "1.2.0",
  "mcpName": "io.github.mario-andreschak/mcp-whatsapp-web",
  "description": "TypeScript MCP server for WhatsApp using whatsapp-web.js or browserless Baileys",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-whatsapp-web": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mario-andreschak/mcp-whatsapp-web.git"
  },
  "homepage": "https://github.com/mario-andreschak/mcp-whatsapp-web#readme",
  "bugs": {
    "url": "https://github.com/mario-andreschak/mcp-whatsapp-web/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --no-deprecation dist/index.js",
    "dev": "tsc -w & node --no-deprecation --watch dist/index.js",
    "debug": "npx @modelcontextprotocol/inspector node --no-deprecation --trace-deprecation dist/index.js",
    "lint": "eslint src test",
    "format": "prettier --write src/**/*.ts",
    "cleanup-browsers": "node dist/utils/cleanup-browsers.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:wire": "npm run build && node scripts/wire-smoke.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "whatsapp",
    "typescript",
    "whatsapp-web.js",
    "baileys"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/server-legacy": "^2.0.0",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.4.3",
    "@modelcontextprotocol/core": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "9.6.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.4.5",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "puppeteer": "^25.10.0"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "better-sqlite3@12.8.0": true,
    "ffmpeg-static@5.3.0": true,
    "puppeteer@24.38.0": true,
    "protobufjs@7.6.6": true
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "12.8.0"
  },
  "overrides": {
    "puppeteer": "^25.10.0",
    "@hono/node-server": "^1.19.15",
    "hono": "^4.13.7",
    "ip-address": "^10.7.0",
    "qs": "^6.16.0",
    "brace-expansion@2": "^2.1.4"
  },
  "bundleDependencies": [
    "whatsapp-web.js"
  ]
}
